  socket-proxy:
    image: tecnativa/docker-socket-proxy:latest
    container_name: socket-proxy
    networks:
      - edge
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock:ro
    environment:
      - CONTAINERS=1
      - SERVICES=1
      - IMAGES=1
    read_only: true
    cap_drop:
      - ALL
    security_opt:
      - no-new-privileges:true
    restart: unless-stopped
